# 플랫폼은 호스트의 네이티브 Linux 아키텍처를 따른다.
FROM python:3.11-slim-bookworm AS model-init
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY scripts/download_cpu_model.py ./scripts/download_cpu_model.py
COPY docker/qwen3-model.json ./docker/qwen3-model.json
COPY third_party/qwen3 /licenses/qwen3
RUN useradd --uid 10001 --create-home kaption \
    && mkdir -p /models && chown kaption:kaption /models
USER kaption
CMD ["sh", "-c", "python scripts/download_cpu_model.py && cp /licenses/qwen3/LICENSE /licenses/qwen3/NOTICE.md /models/"]

FROM python:3.11-slim-bookworm AS backend
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 TOKENIZERS_PARALLELISM=false \
    KAPTION_JOB_DIR=/data/jobs HF_HOME=/cache/huggingface
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-api.txt requirements-stt.txt ./
RUN python -m pip install --no-cache-dir -r requirements-api.txt && python -m pip check
COPY app ./app
COPY transcribe.py timing.py ./
COPY templates/korean.json ./templates/korean.json
COPY data/physics_glossary.json data/qwen_translation_terms.json ./data/
RUN useradd --uid 10001 --create-home kaption \
    && mkdir -p /data/jobs /cache/huggingface \
    && chown -R kaption:kaption /data /cache
USER kaption
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD ["python", "-c", "import json,urllib.request; assert json.load(urllib.request.urlopen('http://127.0.0.1:8000/health',timeout=3))['translation_model_loaded']"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
